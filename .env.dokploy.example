# New API Configuration for Dokploy

# Port to expose on the host (if mapped)
PORT=3000

# PostgreSQL credentials
POSTGRES_USER=newapi
POSTGRES_PASSWORD=generate_a_secure_postgres_password_here
POSTGRES_DB=new_api

# Redis password
REDIS_PASSWORD=generate_a_secure_redis_password_here

# Secret session key (recommended 32+ characters)
SESSION_SECRET=super_secret_random_string_replace_in_production

# Timezone (e.g., UTC, America/New_York, Asia/Kolkata, etc.)
TZ=UTC
